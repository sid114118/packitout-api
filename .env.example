# Copy to .env (gitignored) and fill in real values.

# MongoDB connection string used by mongoose.connect()
MONGO_URI=

# Gemini API key for /extract-parchi route. Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Payment model:
#   - 'UPI' → customer transfers directly to the shop's UPI ID at checkout.
#             Shop confirms receipt via POST /orders/:id/mark-paid.
#   - 'POP' → pay on pickup (cash / in-person UPI at the counter).
# No payment gateway is used — money flows directly to the shop's bank.

# Cloudinary credentials. Old hardcoded values in index.js have been moved here
# — they are public in git history; ROTATE on the Cloudinary dashboard and set
# the new ones below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OneSignal credentials. Same story as Cloudinary — old ones are public, ROTATE.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Admin dashboard auth. The dashboard sends the token in X-Admin-Token; the
# password is checked at POST /admin/login. Pick a long random string for the
# token (e.g. `openssl rand -hex 32`) and a strong password.
ADMIN_PASSWORD=
ADMIN_TOKEN=

# CORS allowlist — comma-separated origins. Use "*" only for testing.
# Example: https://packitout.app,https://admin.packitout.app
CORS_ORIGINS=*

# Firebase Admin SDK credentials. Two formats supported (only one is needed):
#
# Format A — three separate vars (recommended for Hostinger / panels that
# mangle JSON blobs). From the service-account JSON you download, copy:
#   project_id   → FIREBASE_PROJECT_ID
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key  → FIREBASE_PRIVATE_KEY  (paste as-is, the \n escapes are fine)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#
# Format B — single-blob JSON (use for local dev or Vercel/Netlify). Entire
# service-account JSON on one line, no surrounding quotes.
# FIREBASE_SERVICE_ACCOUNT_JSON=
