# Copy to .env (gitignored) and fill in real values.

# MongoDB connection string used by mongoose.connect()
MONGO_URI=

# Gemini API key for /extract-parchi route. Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Razorpay keys for /payments/create-order and /payments/verify.
# Sign up at https://dashboard.razorpay.com — use TEST mode keys (rzp_test_...) until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
